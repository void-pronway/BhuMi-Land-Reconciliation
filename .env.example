# LOCAL: leave DATABASE_URL empty to use embedded PostgreSQL.
DATABASE_PATH=.data/bhumi
# RENDER: use a hosted PostgreSQL pooled connection URL; local disk is not used.
DATABASE_URL=
APP_ORIGIN=http://localhost:3000
# Creates the first administrator once. Existing account passwords are NOT reset.
ADMIN_EMAIL=admin@bhumi.local
ADMIN_PASSWORD=
# Only fictional fixtures. Set false for an intentionally empty database.
SEED_DEMO=true
# REVIEWER_PASSWORD and SESSION_SECRET from v1 are no longer used.

# Public judge account for fictional competition records only.
PUBLIC_DEMO_ACCESS=true
